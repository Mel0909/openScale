<?xml version="1.0" encoding="utf-8"?>
<!-- Sheet "Nova medição": data/hora, peso com +/-, campos manuais, anotação. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/android:colorBackground"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/rd_screen_margin"
        android:paddingTop="14dp"
        android:paddingEnd="@dimen/rd_screen_margin"
        android:paddingBottom="28dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_rd_sheet_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rd_add_title"
                android:textAppearance="@style/TextAppearance.OpenScale.ScreenTitle"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/rd_add_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="✕"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Data e hora -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/rd_add_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/rd_gap_tight"
                android:layout_weight="1"
                android:background="@drawable/bg_rd_field"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="64dp"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rd_add_date"
                    android:textAppearance="@style/TextAppearance.OpenScale.LabelMicro"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/rd_add_date_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textAppearance="@style/TextAppearance.OpenScale.Label"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14.5sp"
                    tools:text="19 set 2026" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rd_add_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_rd_field"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="64dp"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rd_add_time"
                    android:textAppearance="@style/TextAppearance.OpenScale.LabelMicro"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/rd_add_time_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textAppearance="@style/TextAppearance.OpenScale.Label"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14.5sp"
                    tools:text="09:41" />
            </LinearLayout>
        </LinearLayout>

        <!-- Peso com botões +/- -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.OpenScale.Card.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rd_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rd_add_weight"
                    android:textAppearance="@style/TextAppearance.OpenScale.LabelMicro"
                    android:textSize="10.5sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rd_add_decrease"
                        style="@style/Widget.OpenScale.Button.Outlined"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:contentDescription="@string/rd_add_decrease"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="−"
                        android:textSize="22sp" />

                    <LinearLayout
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:baselineAligned="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/rd_add_weight_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.OpenScale.HeroNumber"
                            android:textSize="56sp"
                            tools:text="72,4" />

                        <TextView
                            android:id="@+id/rd_add_weight_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textAppearance="@style/TextAppearance.OpenScale.Unit"
                            android:textSize="16sp"
                            tools:text="kg" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rd_add_increase"
                        style="@style/Widget.OpenScale.Button.Outlined"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:contentDescription="@string/rd_add_increase"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="+"
                        android:textSize="22sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/rd_add_weight_delta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textAppearance="@style/TextAppearance.OpenScale.Body"
                    android:textSize="12sp"
                    tools:text="↓ 0,6 kg em relação a 12 set" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Campos manuais -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rd_gap_section"
            android:layout_marginBottom="@dimen/rd_gap_tight"
            android:text="@string/rd_add_manual_measures"
            android:textAppearance="@style/TextAppearance.OpenScale.LabelMicro"
            android:textSize="10.5sp" />

        <LinearLayout
            android:id="@+id/rd_add_manual_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Anotação -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rd_gap"
            android:layout_marginBottom="@dimen/rd_gap_tight"
            android:text="@string/rd_add_note"
            android:textAppearance="@style/TextAppearance.OpenScale.LabelMicro"
            android:textSize="10.5sp" />

        <EditText
            android:id="@+id/rd_add_note_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rd_field"
            android:gravity="top|start"
            android:hint="@string/rd_add_note_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:minHeight="88dp"
            android:padding="15dp"
            android:textAppearance="@style/TextAppearance.OpenScale.Body"
            android:textSize="14sp"
            tools:ignore="LabelFor" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rd_add_save"
            style="@style/Widget.OpenScale.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rd_gap_section"
            android:text="@string/rd_add_save" />
    </LinearLayout>
</ScrollView>
