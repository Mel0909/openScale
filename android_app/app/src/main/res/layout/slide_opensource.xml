<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Slide do guia inicial, redesenhado com os tokens.
  ~ O id slideMainText e mantido: os fragments o referenciam.
  -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="120dp">

        <ImageView
            android:id="@+id/imgSlide"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="88dp"
            android:background="@drawable/bg_rd_slide_icon"
            android:contentDescription="@null"
            android:padding="24dp"
            app:srcCompat="@drawable/ic_slide_opensource"
            app:tint="?attr/colorOnPrimaryContainer" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:gravity="center"
            android:text="@string/label_slide_opensource_top_text"
            android:textAppearance="@style/TextAppearance.OpenScale.ScreenTitle" />

        <TextView
            android:id="@+id/slideMainText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/label_slide_opensource_main_text"
            android:textAppearance="@style/TextAppearance.OpenScale.Body" />
    </LinearLayout>
</ScrollView>
