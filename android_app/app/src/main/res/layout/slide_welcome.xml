<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Slide 1 de 7: boas-vindas.
  ~ Redesenhado com os tokens: fundo do tema, título em Bricolage, corpo em
  ~ Instrument Sans. O ícone ganha um círculo de primaryContainer atrás, em
  ~ vez de flutuar solto como na versão antiga.
  -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="120dp">

        <ImageView
            android:id="@+id/imgSlide"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_marginTop="96dp"
            android:background="@drawable/bg_rd_slide_icon"
            android:contentDescription="@null"
            android:padding="24dp"
            app:srcCompat="@drawable/ic_launcher_openscale"
            app:tint="?attr/colorOnPrimaryContainer" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/label_slide_welcome_top_text"
            android:textAppearance="@style/TextAppearance.OpenScale.ScreenTitle"
            android:textSize="30sp"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/label_slide_welcome_main_text"
            android:textAppearance="@style/TextAppearance.OpenScale.Body"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15" />
    </LinearLayout>
</ScrollView>
