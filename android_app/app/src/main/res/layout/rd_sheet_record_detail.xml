<?xml version="1.0" encoding="utf-8"?>
<!-- Detalhe de uma medição: todas as métricas, anotação, editar/apagar. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/android:colorBackground"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/rd_screen_margin"
        android:paddingTop="14dp"
        android:paddingEnd="@dimen/rd_screen_margin"
        android:paddingBottom="28dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_rd_sheet_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/rd_detail_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.OpenScale.LabelMicro"
                    android:textSize="10.5sp"
                    tools:text="17 set 2026 · 08:12" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/rd_detail_weight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.OpenScale.HeroNumber"
                        android:textSize="46sp"
                        tools:text="72,4" />

                    <TextView
                        android:id="@+id/rd_detail_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textAppearance="@style/TextAppearance.OpenScale.Unit"
                        android:textSize="15sp"
                        tools:text="kg" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/rd_detail_delta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginBottom="6dp"
                android:textAppearance="@style/TextAppearance.OpenScale.Delta"
                android:textColor="?attr/colorPrimary"
                tools:text="↓ 0,6 kg" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.OpenScale.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:id="@+id/rd_detail_metrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="?android:attr/listDivider"
                android:orientation="vertical"
                android:showDividers="middle" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/rd_detail_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_rd_note"
            android:padding="15dp"
            android:textAppearance="@style/TextAppearance.OpenScale.Body"
            android:textSize="13sp"
            tools:text="Manhã, em jejum." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rd_detail_edit"
                style="@style/Widget.OpenScale.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/rd_gap_tight"
                android:layout_weight="1"
                android:text="@string/rd_record_edit" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rd_detail_delete"
                style="@style/Widget.OpenScale.Button.Danger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rd_record_delete" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
