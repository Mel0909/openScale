<?xml version="1.0" encoding="utf-8"?>
<!-- Linha "métrica · valor" no detalhe de uma medição. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="11dp"
    android:paddingBottom="11dp">

    <TextView
        android:id="@+id/rd_detail_row_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.OpenScale.Body"
        android:textSize="13sp"
        tools:text="Gordura corporal" />

    <TextView
        android:id="@+id/rd_detail_row_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.OpenScale.Label"
        android:textSize="13.5sp"
        android:textColor="?attr/colorOnSurface"
        tools:text="23,8 %" />
</LinearLayout>
