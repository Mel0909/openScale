<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Slide 3 de 7: criar o primeiro perfil.
  ~ Mantém os ids btnAddUser e tblUsers, usados por UserIntroSlide, que
  ~ preenche a tabela em runtime.
  -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="120dp">

        <ImageView
            android:id="@+id/imgSlide"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="72dp"
            android:background="@drawable/bg_rd_slide_icon"
            android:contentDescription="@null"
            android:padding="24dp"
            app:srcCompat="@drawable/ic_rd_profile"
            app:tint="?attr/colorOnPrimaryContainer" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/label_slide_user_top_text"
            android:textAppearance="@style/TextAppearance.OpenScale.ScreenTitle" />

        <TextView
            android:id="@+id/slideMainText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/label_slide_user_main_text"
            android:textAppearance="@style/TextAppearance.OpenScale.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddUser"
            style="@style/Widget.OpenScale.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/rd_slide_add_person" />

        <!-- Lista de perfis criados. UserIntroSlide preenche em runtime;
             fica vazia até o primeiro perfil existir. -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.OpenScale.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <TableLayout
                android:id="@+id/tblUsers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
