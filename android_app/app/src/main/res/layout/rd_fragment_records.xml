<?xml version="1.0" encoding="utf-8"?>
<!-- Tela Medições: lista agrupada por mês. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/rd_screen_margin"
    android:paddingEnd="@dimen/rd_screen_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/rd_nav_records"
            android:textAppearance="@style/TextAppearance.OpenScale.ScreenTitle" />

        <TextView
            android:id="@+id/rd_records_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.OpenScale.Label"
            android:textSize="12.5sp"
            tools:text="128 registros" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rd_records_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/rd_content_bottom_padding"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/rd_records_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/rd_records_empty"
        android:textAppearance="@style/TextAppearance.OpenScale.Body"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
