<?xml version="1.0" encoding="utf-8"?>
<!-- Campo manual (cintura, quadril…) no sheet de nova medição. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/rd_gap_tight"
    android:background="@drawable/bg_rd_field"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <TextView
        android:id="@+id/rd_manual_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.OpenScale.Label"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurface"
        tools:text="Cintura" />

    <EditText
        android:id="@+id/rd_manual_input"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:background="@null"
        android:gravity="end"
        android:hint="—"
        android:importantForAutofill="no"
        android:inputType="numberDecimal"
        android:maxLength="6"
        android:textAppearance="@style/TextAppearance.OpenScale.SecondaryNumber"
        android:textSize="20sp"
        tools:ignore="LabelFor"
        tools:text="78,0" />

    <TextView
        android:id="@+id/rd_manual_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textAppearance="@style/TextAppearance.OpenScale.Unit"
        android:textSize="12sp"
        tools:text="cm" />
</LinearLayout>
