<?xml version="1.0" encoding="utf-8"?>
<!-- Uma medição na lista: dia/hora, peso, outras métricas, variação. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.OpenScale.Card.Clickable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/rd_gap_tight"
    android:minHeight="@dimen/rd_record_row_min_height">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rd_record_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.OpenScale.Label"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                tools:text="17 set" />

            <TextView
                android:id="@+id/rd_record_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textAppearance="@style/TextAppearance.OpenScale.LabelMicro"
                android:textAllCaps="false"
                android:letterSpacing="0"
                android:textSize="11.5sp"
                tools:text="08:12" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/rd_record_weight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.OpenScale.SecondaryNumber"
                    android:textSize="23sp"
                    tools:text="72,4" />

                <TextView
                    android:id="@+id/rd_record_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:textAppearance="@style/TextAppearance.OpenScale.Unit"
                    android:textSize="12sp"
                    tools:text="kg" />
            </LinearLayout>

            <TextView
                android:id="@+id/rd_record_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.OpenScale.LabelMicro"
                android:textAllCaps="false"
                android:letterSpacing="0"
                android:textSize="12sp"
                tools:text="23,8% gordura · 54,1% água" />
        </LinearLayout>

        <TextView
            android:id="@+id/rd_record_delta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/rd_gap_tight"
            android:textAppearance="@style/TextAppearance.OpenScale.Delta"
            android:textSize="12.5sp"
            android:textColor="?attr/colorPrimary"
            tools:text="↓ 0,6" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
