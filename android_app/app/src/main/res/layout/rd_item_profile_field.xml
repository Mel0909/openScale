<?xml version="1.0" encoding="utf-8"?>
<!-- Campo do perfil: rótulo, valor e a frase do que ele alimenta. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.OpenScale.Card.Clickable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/rd_gap_tight"
    android:minHeight="@dimen/rd_profile_row_min_height">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rd_field_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.OpenScale.LabelMicro"
                android:textSize="10.5sp"
                tools:text="Altura" />

            <TextView
                android:id="@+id/rd_field_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.OpenScale.SecondaryNumber"
                android:textSize="22sp"
                tools:text="170 cm" />

            <TextView
                android:id="@+id/rd_field_feeds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.OpenScale.Body"
                android:textSize="11.5sp"
                tools:text="Entra em IMC, massa magra e cintura-altura" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/rd_gap"
            android:text="›"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="18sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
