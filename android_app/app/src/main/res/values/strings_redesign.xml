<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Strings do redesign.
  ~
  ~ Ficam em arquivo separado de strings.xml de propósito: strings.xml é a
  ~ fonte que o Weblate distribui aos tradutores, e misturar chaves novas
  ~ com o histórico dele complica o merge. O Weblate pode ser configurado
  ~ depois para incluir este arquivo.
  ~
  ~ O inglês aqui é a fonte de verdade. Os textos em português do protótipo
  ~ vivem em values-pt-rBR/strings_redesign.xml.
  -->
