<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Certificados do provedor de Downloadable Fonts do Google Play.
  ~ Valores públicos e fixos, publicados pelo Google — não são segredo.
  ~ Exigidos por res/font/*.xml (fontProviderCerts).
  ~
  ~ Se as fontes passarem a ser empacotadas como .ttf (ver decisão §3 em
  ~ .claude/docs/decisoes-implementacao.md), este arquivo pode ser removido.
  -->
<resources>
    <array name="com_google_android_gms_fonts_certs">
        <item>@array/com_google_android_gms_fonts_certs_dev</item>
        <item>@array/com_google_android_gms_fonts_certs_prod</item>
    </array>
    <string-array name="com_google_android_gms_fonts_certs_dev">
        <item>
            
        </item>
    </string-array>
    <string-array name="com_google_android_gms_fonts_certs_prod">
        <item>
            
        </item>
    </string-array>
</resources>
