<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Tema do redesign. Herda de Theme.Material3.DayNight, que é o que faz os
  ~ slots do design (colorPrimaryContainer, colorSurfaceVariant, colorOutline…)
  ~ existirem como ?attr — no AppCompat eles não existem.
  ~
  ~ As cores vêm de colors_m3.xml, e a variante escura é resolvida
  ~ automaticamente por values-night/colors_m3.xml.
  -->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.OpenScale" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Primárias -->
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>

        <!-- Secundárias -->
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>

        <!-- Terciárias -->
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>

        <!-- Superfícies -->
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>

        <!-- Contornos -->
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>

        <!-- Erro -->
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>

        <!-- Barras do sistema: o design não usa toolbar, a status bar fica
             sobre o próprio fundo da tela. -->
        <item name="android:statusBarColor">@color/md_background</item>
        <item name="android:navigationBarColor">@color/md_surface</item>

        <!-- Tipografia -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.OpenScale.HeroNumber</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.OpenScale.SecondaryNumber</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.OpenScale.ScreenTitle</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.OpenScale.SectionTitle</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.OpenScale.Body</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.OpenScale.Label</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.OpenScale.LabelMicro</item>

        <!-- O design é explicitamente sem sombra: no claro a hierarquia vem do
             surface mais branco que o background, no escuro de uma borda de 1px. -->
        <item name="elevationOverlayEnabled">false</item>

        <item name="android:datePickerStyle">@style/DatePickerStyle</item>
    </style>

    <!-- A status bar com ícones escuros só existe a partir da API 23.
         Sem isto, no tema claro os ícones ficam brancos sobre fundo rosado. -->
    <style name="Theme.OpenScale.Light" parent="Theme.OpenScale" />

</resources>
